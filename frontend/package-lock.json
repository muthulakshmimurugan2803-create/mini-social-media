.login-page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f0f2f5;
}

.login-card {
  width: 350px;
  padding: 30px;
  background: white;
  border-radius: 15px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
  text-align: center;
}

.login-title {
  color: #1877f2;
  margin-bottom: 10px;
}

.login-card h2 {
  margin-bottom: 25px;
}

.login-input {
  width: 100%;
  box-sizing: border-box;
  padding: 12px;
  margin-bottom: 15px;
  border: 1px solid #ddd;
  border-radius: 8px;
  font-size: 15px;
}

.login-button {
  width: 100%;
  padding: 12px;
  border: none;
  border-radius: 8px;
  background: #1877f2;
  color: white;
  font-size: 16px;
  cursor: pointer;
}

.login-button:hover {
  background: #166fe5;
}

.register-link {
  margin-top: 20px;
}